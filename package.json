{
  "name": "agents-sandbox",
  "version": "0.1.0",
  "description": "Run Pi or Claude Code in a worktree-scoped Docker sandbox",
  "type": "module",
  "bin": {
    "sandbox": "bin/sandbox.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "docker/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:syntax": "node scripts/check-syntax.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.0.0"
  },
  "license": "AGPL-3.0-only"
}
