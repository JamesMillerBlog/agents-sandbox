# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# Build locally with:
#   docker build -f docker/Dockerfile.pi -t pi-docker-agent:pi-0.84.4 .
# The launcher never builds or pulls this image automatically.
FROM node:22-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284

ARG PI_VERSION=0.84.4

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git gh openssh-client python3 \
    && rm -rf /var/lib/apt/lists/*

ENV npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false

RUN npm install --global --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}"

# The official Node image has a uid/gid 1000 account. Rename it rather than
# creating a second account with a colliding id; docker run --user then maps
# the host uid/gid explicitly.
RUN usermod --login sandbox --home /home/sandbox --move-home node \
    && groupmod --new-name sandbox node \
    && mkdir -p /home/sandbox/.pi/agent /home/sandbox/.config /workspace \
    && chown -R sandbox:sandbox /home/sandbox /workspace \
    && chmod -R a+rwX /home/sandbox

WORKDIR /workspace
USER sandbox
ENTRYPOINT ["pi"]
